<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KinopoiskApp.Controls"
    xmlns:viewModels="using:KinopoiskApp.ViewModels"
    x:Class="KinopoiskApp.Views.MainPage">

    <Grid>
        <ProgressRing IsActive="{Binding IsLoading}" 
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Width="50" Height="50"/>

        <ListView ItemsSource="{Binding Movies}"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Постер фильма -->
                        <Image Source="{Binding PosterUrl}" 
                               Width="100" Height="150"
                               Stretch="UniformToFill"/>

                        <!-- Информация о фильме -->
                        <StackPanel Grid.Column="1" Margin="12,0">
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Year}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Rating, Converter={StaticResource RatingConverter}}"/>
                        </StackPanel>

                        <!-- Кнопка избранного -->
                        <controls:FavoriteButton 
                            Grid.Column="2"
                            IsFavorite="{Binding IsFavorite, Mode=TwoWay}"
                            HorizontalAlignment="Right"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>